# URL used by browser requests. Set this to the public backend URL in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# URL used by server-rendered Next.js requests.
# In root Docker Compose use http://backend:8000/api/v1.
# When frontend and backend are hosted separately, set the backend's public URL.
INTERNAL_API_URL=http://backend:8000/api/v1